# このファイルを .env にコピーして、実際の値を入れてください
# cp .env.example .env

# --- Claude API (必須) ---
# https://console.anthropic.com で発行したAPIキー
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# 使用モデル名。最新の推奨モデルは https://docs.claude.com で要確認
CLAUDE_MODEL=claude-sonnet-5

# --- 配信方法: email / slack / both ---
DELIVERY_METHOD=email

# --- メール配信設定(DELIVERY_METHODがemailかbothの場合に必要) ---
# Gmailの場合はSMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Gmailは「アプリパスワード」の発行が別途必要(通常のログインパスワードは使えません)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=your_email@gmail.com

# --- Slack配信設定(DELIVERY_METHODがslackかbothの場合に必要) ---
# SlackのIncoming Webhook URL (https://api.slack.com/messaging/webhooks)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxxx/xxxx/xxxx
